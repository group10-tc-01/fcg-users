{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=127.0.0.1;Database=fcg_user;TrustServerCertificate=True;"
  },
  "KafkaSettings": {
    "BootstrapServers": "bootstrap",
    "UseSaslSsl": false,
    "UserCreatedTopic": "user-created",
    "SaslUsername": "",
    "SaslPassword": ""
  },
  "Observability": {
    "ServiceName": "FCG.Users",
    "EnableOtlpExporter": true
  },
  "JwtSettings": {
    "SecretKey": "change-me-use-user-secrets-or-key-vault",
    "Issuer": "FCG-User",
    "Audience": "FCG-Client",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  }
}
