{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=127.0.0.1;Database=fcg_user;TrustServerCertificate=True;"
  },
  "KafkaSettings": {
    "BootstrapServers": "bootstrap",
    "UseSaslSsl": false,
    "UserCreatedTopic": "user-created",
    "SaslUsername": "$ConnectionString",
    "SaslPassword": ""
  },
  "Observability": {
    "ServiceName": "FCG.Users",
    "EnableOtlpExporter": false
  },
  "JwtSettings": {
    "SecretKey": "test-jwt-signing-key-with-minimum-length",
    "Issuer": "FCG-User",
    "Audience": "FCG-Client",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  }
}
